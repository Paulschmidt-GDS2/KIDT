@* Kalender-Seite: Monats-/Wochen-/Tagesansicht mit Terminen *@
@page "/kalender"
@using System.Globalization
@using KIDT.Services
@using KIDT.Models
@inject CalendarService CalendarService
@inject NavigationManager Navigation

<div class="page-container">
    @* Toolbar: Navigation und Ansichts-Auswahl *@
    <div class="calendar-toolbar">
        <div class="toolbar-left">
            <button class="nav-button" @onclick="Prev">&lt;</button> @* Vorherige Periode *@
            <button class="nav-button today-button" @onclick="Today">Heute</button> @* Zur heutigen Ansicht springen *@
            <button class="nav-button" @onclick="Next">&gt;</button> @* Nächste Periode *@
        </div>
        <div class="toolbar-center">
            <span class="view-title">@ViewTitle</span> @* Zeige aktuellen Monat/Woche/Tag *@
        </div>
        <div class="toolbar-right">
            <div class="view-buttons">
                <button class="view-button @(currentView == "Month" ? "active" : "")" @onclick='() => currentView = "Month"'>Monat</button>
                <button class="view-button @(currentView == "Week" ? "active" : "")" @onclick='() => currentView = "Week"'>Woche</button>
                <button class="view-button @(currentView == "Day" ? "active" : "")" @onclick='() => currentView = "Day"'>Tag</button>
            </div>
        </div>
    </div>

    @* Scrollbarer Kalender-Bereich *@
    <div class="calendar-container">
        @if (currentView == "Month") @* Monatsansicht: 7x6 Grid *@
        {
            <div class="month-grid">
                @foreach (var dayName in DayNames) @* Wochentag-Header *@
                {
                    <div class="weekday-header">@dayName</div>
                }

                @foreach (var cell in MonthCells) @* 42 Tageszellen *@
                {
                    var isCurrentMonth = cell.Month == DisplayMonth.Month && cell.Year == DisplayMonth.Year; // Check: Ist Zelle im aktuellen Monat?
                    var isToday = cell.Date == DateTime.Today; // Check: Ist heute?
                    <div class="day-cell @(isCurrentMonth ? "current-month" : "other-month") @(isToday ? "today" : "")" @onclick="() => OnDayClick(cell)">
                        <div class="day-number">@cell.Day</div> @* Tagesnummer *@
                        <div class="events-preview">
                            @foreach (var ev in GetEventsForDate(cell).Take(3)) @* Zeige max 3 Termine *@
                            {
                                <div class="event-item event-color-@ev.ColorIndex" style="background: @availableColors[ev.ColorIndex] !important;" @onclick="@((e) => OnEventClick(ev, e))" @onclick:stopPropagation="true">
                                    <span class="event-title-text">@ev.Title</span>
                                    @if (!ev.IsAllDay && ev.HasTime)
                                    {
                                        <span class="event-time-text">@FormatEventTime(ev)</span>
                                    }
                                </div>
                            }
                            @if (GetEventsForDate(cell).Count > 3) @* Zeige Anzahl weiterer Termine *@
                            {
                                <div class="more">+@(GetEventsForDate(cell).Count - 3)</div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else if (currentView == "Week") @* Wochenansicht *@
        {
            <div class="week-view">
                <div class="week-header">
                    @foreach (var day in WeekDays) @* Wochentag-Header *@
                    {
                        <div class="week-day-header">@day.ToString("ddd dd.MM", germanCulture)</div>
                    }
                </div>
                <div class="week-body">
                    @foreach (var day in WeekDays) @* Tagesspalten *@
                    {
                        var isToday = day.Date == DateTime.Today; // Check: Ist heute?
                        <div class="week-day @(isToday ? "today" : "")" @onclick="() => OnDayClick(day)">
                            <div class="day-number">@day.Day</div>
                            @foreach (var ev in GetEventsForDate(day)) @* Alle Termine des Tages *@
                            {
                                <div class="event-item event-color-@ev.ColorIndex" style="background: @availableColors[ev.ColorIndex] !important;" @onclick="@((e) => OnEventClick(ev, e))" @onclick:stopPropagation="true">
                                    <span class="event-title-text">@ev.Title</span>
                                    @if (!ev.IsAllDay && ev.HasTime)
                                    {
                                        <span class="event-time-text">@FormatEventTime(ev)</span>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
        else if (currentView == "Day") @* Tagesansicht *@
        {
            <div class="day-view">
                <h4 class="day-title">@DisplayDay.ToString("dddd, dd.MM.yyyy", germanCulture)</h4>

                @* Bestehende Termine des Tages *@
                @if (GetEventsForDate(DisplayDay).Any())
                {
                    <div class="day-events">
                        @foreach (var ev in GetEventsForDate(DisplayDay))
                        {
                            <div class="event-item event-color-@ev.ColorIndex" style="background: @availableColors[ev.ColorIndex] !important;" @onclick="@((e) => OnEventClick(ev, e))" @onclick:stopPropagation="true">
                                <span class="event-title-text">@ev.Title</span>
                                @if (!ev.IsAllDay && ev.HasTime)
                                {
                                    <span class="event-time-text">@ev.Time.ToString(@"hh\:mm")</span>
                                }
                            </div>
                        }
                    </div>
                }

                @* Inline-Formular zum Erstellen neuer Termine *@
                <div class="day-inline-form">
                    <h5 class="inline-form-title">Neuen Termin erstellen</h5>

                    <input class="dialog-input" placeholder="Titel" @bind="newEventText" />

                    <div class="dialog-time-group">
                        <div class="checkbox-wrapper">
                            <input type="checkbox" id="dayAllDay" class="time-checkbox" @bind="isAllDay" />
                            <label for="dayAllDay" class="checkbox-label">Ganztägig</label>
                        </div>
                        @if (!isAllDay)
                        {
                            <div class="time-span-row">
                                <div class="time-input-wrapper">
                                    <label class="input-label">Von:</label>
                                    <div class="time-custom-group">
                                        <input type="text" class="time-num-input" value="@(selectedTimeHour.ToString("D2"))" @onchange="OnAddStartHourChanged" placeholder="HH" />
                                        <span class="time-colon">:</span>
                                        <input type="text" class="time-num-input" value="@(selectedTimeMinute.ToString("D2"))" @onchange="OnAddStartMinuteChanged" placeholder="MM" />
                                    </div>
                                </div>
                                <span class="time-span-separator">–</span>
                                <div class="time-input-wrapper">
                                    <label class="input-label">Bis:</label>
                                    <div class="time-custom-group">
                                        <input type="text" class="time-num-input" value="@(selectedEndTimeHour.ToString("D2"))" @onchange="OnAddEndHourChanged" placeholder="HH" />
                                        <span class="time-colon">:</span>
                                        <input type="text" class="time-num-input" value="@(selectedEndTimeMinute.ToString("D2"))" @onchange="OnAddEndMinuteChanged" placeholder="MM" />
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="dialog-color-section">
                        <div class="color-picker-label">Farbe wählen:</div>
                        <div class="dialog-color-picker">
                            @for (int i = 0; i < availableColors.Length; i++)
                            {
                                var colorIndex = i;
                                <div class="color-option @(selectedColorIndex == colorIndex ? "selected" : "")" 
                                     style="background: @availableColors[colorIndex];"
                                     @onclick="() => selectedColorIndex = colorIndex">
                                </div>
                            }
                        </div>
                    </div>

                    <div class="dialog-reminder-section">
                        <div class="reminder-label-header">Erinnerung</div>
                        <div class="reminder-buttons">
                            <button type="button" class="reminder-btn @(newEventReminderMinutes == null ? "active" : "")" 
                                    @onclick="() => newEventReminderMinutes = null">Keine</button>
                            <button type="button" class="reminder-btn @(newEventReminderMinutes == 5 ? "active" : "")" 
                                    @onclick="() => newEventReminderMinutes = 5">5 Min</button>
                            <button type="button" class="reminder-btn @(newEventReminderMinutes == 15 ? "active" : "")" 
                                    @onclick="() => newEventReminderMinutes = 15">15 Min</button>
                            <button type="button" class="reminder-btn @(newEventReminderMinutes == 30 ? "active" : "")" 
                                    @onclick="() => newEventReminderMinutes = 30">30 Min</button>
                            <button type="button" class="reminder-btn @(newEventReminderMinutes == 60 ? "active" : "")" 
                                    @onclick="() => newEventReminderMinutes = 60">1 Stunde</button>
                            <button type="button" class="reminder-btn @(newEventReminderMinutes == 120 ? "active" : "")" 
                                    @onclick="() => newEventReminderMinutes = 120">2 Stunden</button>
                            <button type="button" class="reminder-btn @(newEventReminderMinutes == 1440 ? "active" : "")" 
                                    @onclick="() => newEventReminderMinutes = 1440">1 Tag</button>
                            <button type="button" class="reminder-btn @(newEventReminderMinutes == 10080 ? "active" : "")" 
                                    @onclick="() => newEventReminderMinutes = 10080">1 Woche</button>
                        </div>
                    </div>

                    <div class="dialog-actions">
                        <button class="dialog-button save-button" @onclick="SaveDayViewEvent">Hinzufügen</button>
                    </div>
                </div>
            </div>
        }
    </div>

    @* Dialog zum hinzufügen eines Termins *@
    @if (showAddDialog)
    {
        <div class="dialog-backdrop" @onclick="CloseDialog">
            <div class="dialog" @onclick:stopPropagation="true">
                <h4 class="dialog-title">Neuen Termin hinzufügen</h4>
                <div class="dialog-date">
                    <label>Datum: </label>@dialogDate.ToString("dd.MM.yyyy")
                </div>
                <input class="dialog-input" placeholder="Titel" @bind="newEventText" />

                <div class="dialog-time-group">
                    <div class="checkbox-wrapper">
                        <input type="checkbox" id="allDay" class="time-checkbox" @bind="isAllDay" />
                        <label for="allDay" class="checkbox-label">Ganztägig</label>
                    </div>
                    @if (!isAllDay)
                    {
                        <div class="time-span-row">
                            <div class="time-input-wrapper">
                                <label class="input-label">Von:</label>
                                <div class="time-custom-group">
                                    <input type="text" class="time-num-input" value="@(selectedTimeHour.ToString("D2"))" @onchange="OnAddStartHourChanged" placeholder="HH" />
                                    <span class="time-colon">:</span>
                                    <input type="text" class="time-num-input" value="@(selectedTimeMinute.ToString("D2"))" @onchange="OnAddStartMinuteChanged" placeholder="MM" />
                                </div>
                            </div>
                            <span class="time-span-separator">–</span>
                            <div class="time-input-wrapper">
                                <label class="input-label">Bis:</label>
                                <div class="time-custom-group">
                                    <input type="text" class="time-num-input" value="@(selectedEndTimeHour.ToString("D2"))" @onchange="OnAddEndHourChanged" placeholder="HH" />
                                    <span class="time-colon">:</span>
                                    <input type="text" class="time-num-input" value="@(selectedEndTimeMinute.ToString("D2"))" @onchange="OnAddEndMinuteChanged" placeholder="MM" />
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="dialog-color-section">
                    <div class="color-picker-label">Farbe wählen:</div>
                    <div class="dialog-color-picker">
                        @for (int i = 0; i < availableColors.Length; i++)
                        {
                            var colorIndex = i; // Lokale Kopie für Lambda
                            <div class="color-option @(selectedColorIndex == colorIndex ? "selected" : "")" 
                                 style="background: @availableColors[colorIndex];"
                                 @onclick="() => selectedColorIndex = colorIndex">
                            </div>
                        }
                    </div>
                </div>

                <div class="dialog-reminder-section">
                    <div class="reminder-label-header">Erinnerung</div>
                    <div class="reminder-buttons">
                        <button type="button" class="reminder-btn @(newEventReminderMinutes == null ? "active" : "")" 
                                @onclick="() => newEventReminderMinutes = null">Keine</button>
                        <button type="button" class="reminder-btn @(newEventReminderMinutes == 5 ? "active" : "")" 
                                @onclick="() => newEventReminderMinutes = 5">5 Min</button>
                        <button type="button" class="reminder-btn @(newEventReminderMinutes == 15 ? "active" : "")" 
                                @onclick="() => newEventReminderMinutes = 15">15 Min</button>
                        <button type="button" class="reminder-btn @(newEventReminderMinutes == 30 ? "active" : "")" 
                                @onclick="() => newEventReminderMinutes = 30">30 Min</button>
                        <button type="button" class="reminder-btn @(newEventReminderMinutes == 60 ? "active" : "")" 
                                @onclick="() => newEventReminderMinutes = 60">1 Stunde</button>
                        <button type="button" class="reminder-btn @(newEventReminderMinutes == 120 ? "active" : "")" 
                                @onclick="() => newEventReminderMinutes = 120">2 Stunden</button>
                        <button type="button" class="reminder-btn @(newEventReminderMinutes == 1440 ? "active" : "")" 
                                @onclick="() => newEventReminderMinutes = 1440">1 Tag</button>
                        <button type="button" class="reminder-btn @(newEventReminderMinutes == 10080 ? "active" : "")" 
                                @onclick="() => newEventReminderMinutes = 10080">1 Woche</button>
                    </div>
                </div>

                <div class="dialog-actions">
                    <button class="dialog-button save-button" @onclick="ConfirmAdd">Speichern</button>
                    <button class="dialog-button cancel-button" @onclick="CloseDialog">Abbrechen</button>
                </div>
            </div>
        </div>
    }

    @* Edit-Dialog für bestehende Events *@
    @if (showEditDialog && editingEvent != null)
    {
        <div class="dialog-backdrop" @onclick="CloseEditDialog">
            <div class="dialog edit-dialog" @onclick:stopPropagation="true">
                <h4 class="dialog-title">Termin bearbeiten</h4>
                <div class="dialog-date">
                    <label>Datum: </label>@editingEvent.Start.ToString("dd.MM.yyyy")
                </div>

                <div class="dialog-input-group">
                    <label class="input-label">Titel:</label>
                    <input class="dialog-input" placeholder="Titel" @bind="editingEvent.Title" />
                </div>

                <div class="dialog-time-group">
                    <div class="checkbox-wrapper">
                        <input type="checkbox" id="editAllDay" class="time-checkbox" @bind="editingEvent.IsAllDay" />
                        <label for="editAllDay" class="checkbox-label">Ganztägig</label>
                    </div>
                    @if (!editingEvent.IsAllDay)
                    {
                        <div class="time-span-row">
                            <div class="time-input-wrapper">
                                <label class="input-label">Von:</label>
                                <div class="time-custom-group">
                                    <input type="text" class="time-num-input" value="@(editStartHour.ToString("D2"))" @onchange="OnEditStartHourChanged" placeholder="HH" />
                                    <span class="time-colon">:</span>
                                    <input type="text" class="time-num-input" value="@(editStartMinute.ToString("D2"))" @onchange="OnEditStartMinuteChanged" placeholder="MM" />
                                </div>
                            </div>
                            <span class="time-span-separator">–</span>
                            <div class="time-input-wrapper">
                                <label class="input-label">Bis:</label>
                                <div class="time-custom-group">
                                    <input type="text" class="time-num-input" value="@(editEndHour.ToString("D2"))" @onchange="OnEditEndHourChanged" placeholder="HH" />
                                    <span class="time-colon">:</span>
                                    <input type="text" class="time-num-input" value="@(editEndMinute.ToString("D2"))" @onchange="OnEditEndMinuteChanged" placeholder="MM" />
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="dialog-color-section">
                    <div class="color-picker-label">Farbe:</div>
                    <div class="dialog-color-picker">
                        @for (int i = 0; i < availableColors.Length; i++)
                        {
                            var colorIndex = i;
                            <div class="color-option @(editingEvent.ColorIndex == colorIndex ? "selected" : "")" 
                                 style="background: @availableColors[colorIndex];"
                                 @onclick="() => editingEvent.ColorIndex = colorIndex">
                            </div>
                        }
                    </div>
                </div>

                <div class="dialog-reminder-section">
                    <div class="reminder-label-header">Erinnerung</div>
                    <div class="reminder-buttons">
                        <button type="button" class="reminder-btn @(editingEvent.ReminderMinutesBefore == null ? "active" : "")" 
                                @onclick="() => editingEvent.ReminderMinutesBefore = null">Keine</button>
                        <button type="button" class="reminder-btn @(editingEvent.ReminderMinutesBefore == 5 ? "active" : "")" 
                                @onclick="() => { editingEvent.ReminderMinutesBefore = 5; editingEvent.ReminderShown = false; }">5 Min</button>
                        <button type="button" class="reminder-btn @(editingEvent.ReminderMinutesBefore == 15 ? "active" : "")" 
                                @onclick="() => { editingEvent.ReminderMinutesBefore = 15; editingEvent.ReminderShown = false; }">15 Min</button>
                        <button type="button" class="reminder-btn @(editingEvent.ReminderMinutesBefore == 30 ? "active" : "")" 
                                @onclick="() => { editingEvent.ReminderMinutesBefore = 30; editingEvent.ReminderShown = false; }">30 Min</button>
                        <button type="button" class="reminder-btn @(editingEvent.ReminderMinutesBefore == 60 ? "active" : "")" 
                                @onclick="() => { editingEvent.ReminderMinutesBefore = 60; editingEvent.ReminderShown = false; }">1 Stunde</button>
                        <button type="button" class="reminder-btn @(editingEvent.ReminderMinutesBefore == 120 ? "active" : "")" 
                                @onclick="() => { editingEvent.ReminderMinutesBefore = 120; editingEvent.ReminderShown = false; }">2 Stunden</button>
                        <button type="button" class="reminder-btn @(editingEvent.ReminderMinutesBefore == 1440 ? "active" : "")" 
                                @onclick="() => { editingEvent.ReminderMinutesBefore = 1440; editingEvent.ReminderShown = false; }">1 Tag</button>
                        <button type="button" class="reminder-btn @(editingEvent.ReminderMinutesBefore == 10080 ? "active" : "")" 
                                @onclick="() => { editingEvent.ReminderMinutesBefore = 10080; editingEvent.ReminderShown = false; }">1 Woche</button>
                    </div>
                    @if (editingEvent.ReminderMinutesBefore != null && editingEvent.ReminderShown)
                    {
                        <div class="reminder-status-shown">Erinnerung wurde bereits angezeigt</div>
                    }
                </div>

                <div class="dialog-actions">
                    <button class="dialog-button save-button" @onclick="SaveEditedEvent">Speichern</button>
                    <button class="dialog-button delete-button" @onclick="DeleteEvent">Löschen</button>
                    <button class="dialog-button cancel-button" @onclick="CloseEditDialog">Abbrechen</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private string currentView = "Month";
    private DateTime selectedDate = DateTime.Today;
    private DateTime DisplayMonth => new DateTime(selectedDate.Year, selectedDate.Month, 1);
    private DateTime DisplayDay => selectedDate.Date;
    private List<DateTime> MonthCells = new();
    private List<DateTime> WeekDays = new();
    private string[] DayNames = new[] { "Mo", "Di", "Mi", "Do", "Fr", "Sa", "So" };
    private CultureInfo germanCulture = new CultureInfo("de-DE");

    private Dictionary<DateTime, List<CalendarEvent>> events = new();
    private string[] availableColors = new[] { "#848877", "#A8C5DD", "#F4C2B8", "#C3E5A4", "#F7DC9F", "#D4B5E8", "#FFB6C1", "#B0D9B0" };

    private bool showAddDialog = false;
    private bool showEditDialog = false;
    private DateTime dialogDate = DateTime.Today;
    private string newEventText = string.Empty;
    private int selectedColorIndex = 0;
    private CalendarEvent editingEvent = new CalendarEvent();
    private bool isAllDay = true;
    private string selectedTime = "09:00";
    private string selectedEndTime = "10:00";
    private int? newEventReminderMinutes = null;
    private int selectedTimeHour = 9;
    private int selectedTimeMinute = 0;
    private int selectedEndTimeHour = 10;
    private int selectedEndTimeMinute = 0;
    private int editStartHour = 9;
    private int editStartMinute = 0;
    private int editEndHour = 10;
    private int editEndMinute = 0;

    protected override async Task OnInitializedAsync() // Wird beim Laden der Seite aufgerufen
    {
        BuildMonthCells(); // Monats-Grid initialisieren
        BuildWeekDays(); // Wochen-Tage initialisieren
        await LoadEventsAsync(); // Termine aus Datenbank laden
    }

    protected override async Task OnParametersSetAsync()
    {
        var uri = Navigation.Uri;
        var queryIndex = uri.IndexOf("?eventId=");

        if (queryIndex > -1)
        {
            var queryPart = uri.Substring(queryIndex + 9);
            var ampIndex = queryPart.IndexOf("&");
            if (ampIndex > -1) queryPart = queryPart.Substring(0, ampIndex);

            if (int.TryParse(queryPart, out int eventId))
            {
                var ev = await CalendarService.GetEventByIdAsync(eventId);
                if (ev != null)
                {
                    editingEvent = ev;
                    InitEditTimeFields(); // Zeitfelder für Custom-Picker befüllen
                    showEditDialog = true;

                    Navigation.NavigateTo("/Kalender", replace: true);
                }
            }
        }
    }

    private async Task LoadEventsAsync() // Lädt alle Termine aus der Datenbank
    {
        var allEvents = await CalendarService.GetAllEventsAsync(); // Alle Termine laden
        events.Clear(); // Cache leeren

        foreach (var ev in allEvents) // Termine nach Datum gruppieren
        {
            var date = ev.Start.Date; // Nur Datum ohne Uhrzeit
            if (!events.ContainsKey(date)) events[date] = new List<CalendarEvent>();
            events[date].Add(ev);
        }
    }

    private void BuildMonthCells() // Baut 42 Zellen für Monats-Grid (startet montags)
    {
        MonthCells.Clear(); // Liste leeren
        var first = new DateTime(DisplayMonth.Year, DisplayMonth.Month, 1); // Erster Tag des Monats
        int offset = ((int)first.DayOfWeek + 6) % 7; // Offset berechnen (Montag = 0)
        var start = first.AddDays(-offset); // Starttag berechnen (kann im Vormonat liegen)
        for (int i = 0; i < 42; i++) MonthCells.Add(start.AddDays(i)); // 42 Tage hinzufügen
    }

    private void BuildWeekDays() // Baut 7 Tage für Wochenansicht (Montag - Sonntag)
    {
        WeekDays.Clear(); // Liste leeren
        int offset = ((int)selectedDate.DayOfWeek + 6) % 7; // Offset zum Montag berechnen
        var start = selectedDate.AddDays(-offset).Date; // Montag der aktuellen Woche
        for (int i = 0; i < 7; i++) WeekDays.Add(start.AddDays(i)); // 7 Tage hinzufügen
    }

    private void Prev() // Navigiert zur vorherigen Periode
    {
        if (currentView == "Month") selectedDate = selectedDate.AddMonths(-1); // Vorheriger Monat
        else if (currentView == "Week") selectedDate = selectedDate.AddDays(-7); // Vorherige Woche
        else selectedDate = selectedDate.AddDays(-1); // Vorheriger Tag
        BuildMonthCells(); // Grid aktualisieren
        BuildWeekDays(); // Woche aktualisieren
    }

    private void Next() // Navigiert zur Nächsten Periode
    {
        if (currentView == "Month") selectedDate = selectedDate.AddMonths(1); // Nächster Monat
        else if (currentView == "Week") selectedDate = selectedDate.AddDays(7); // Nächste Woche
        else selectedDate = selectedDate.AddDays(1); // Nächster Tag
        BuildMonthCells(); // Grid aktualisieren
        BuildWeekDays(); // Woche aktualisieren
    }

    private void Today() // Springt zur heutigen Ansicht
    {
        selectedDate = DateTime.Today; // Heutiges Datum setzen
        BuildMonthCells(); // Grid aktualisieren
        BuildWeekDays(); // Woche aktualisieren
    }

    private void OnDayClick(DateTime day) // öffnet Dialog beim Klick auf einen Tag
    {
        dialogDate = day.Date; // Datum setzen
        newEventText = string.Empty; // Eingabefeld leeren
        selectedColorIndex = 0; // Standard-Farbe
        isAllDay = true; // Standard: Ganztägig
        selectedTime = "09:00"; // Standard-Startzeit
        selectedEndTime = "10:00"; // Standard-Endzeit
        selectedTimeHour = 9;
        selectedTimeMinute = 0;
        selectedEndTimeHour = 10;
        selectedEndTimeMinute = 0;
        newEventReminderMinutes = null; // Keine Erinnerung als Standard
        showAddDialog = true; // Dialog anzeigen
    }

    private void OnEventClick(CalendarEvent ev, MouseEventArgs e) // öffnet Edit-Dialog beim Klick auf Event
    {
        editingEvent = ev; // Event zum Bearbeiten setzen
        InitEditTimeFields(); // Zeitfelder für Custom-Picker befüllen
        showEditDialog = true; // Edit-Dialog anzeigen
    }

    private void CloseEditDialog() // Schließt Edit-Dialog
    {
        showEditDialog = false; // Dialog verstecken
        editingEvent = new CalendarEvent(); // Event zurücksetzen auf neues Objekt
    }

    private int ClampHour(int h) // Begrenzt Stunden auf 0-23
    {
        if (h < 0) return 0; // Untergrenze
        if (h > 23) return 23; // Obergrenze
        return h;
    }

    private int ClampMinute(int m) // Begrenzt Minuten auf 0-59
    {
        if (m < 0) return 0; // Untergrenze
        if (m > 59) return 59; // Obergrenze
        return m;
    }

    private string FormatTimeStr(int h, int m) // Erstellt Zeit-String "HH:MM" aus Stunden und Minuten
    {
        return $"{h:D2}:{m:D2}";
    }

    private void InitEditTimeFields() // Liest Zeitfelder aus editingEvent für Edit-Dialog
    {
        if (editingEvent == null) return;
        if (editingEvent.HasTime) // Startzeit vorhanden?
        {
            editStartHour = editingEvent.Time.Hours;
            editStartMinute = editingEvent.Time.Minutes;
        }
        else
        {
            editStartHour = 9;
            editStartMinute = 0;
        }
        if (editingEvent.HasEndTime) // Endzeit vorhanden?
        {
            editEndHour = editingEvent.EndTime.Hours;
            editEndMinute = editingEvent.EndTime.Minutes;
        }
        else
        {
            editEndHour = 10;
            editEndMinute = 0;
        }
    }

    private void OnAddStartHourChanged(ChangeEventArgs e) // Handler: Stunden der Startzeit (Add-Dialog)
    {
        int h = 0;
        if (e.Value != null)
        {
            int.TryParse($"{e.Value}", out h); // Eingabe parsen
            h = ClampHour(h); // Gültigkeitsbereich erzwingen
        }
        selectedTimeHour = h;
        selectedTime = FormatTimeStr(selectedTimeHour, selectedTimeMinute); // String-Backup aktualisieren
    }

