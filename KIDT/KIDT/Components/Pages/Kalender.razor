    private async Task SaveEditedEvent() // Speichert bearbeiteten Termin
    {
        if (editingEvent != null && !string.IsNullOrWhiteSpace(editingEvent.Title)) // Check: Titel vorhanden?
        {
            if (!editingEvent.IsAllDay && !editingEvent.HasTime) // Wenn nicht ganztägig, setze Default-Startzeit
            {
                editingEvent.Time = new TimeSpan(9, 0, 0); // Default 09:00
                editingEvent.HasTime = true;
            }
            else if (editingEvent.IsAllDay) // Wenn ganztägig, entferne Zeiten
            {
                editingEvent.Time = TimeSpan.Zero;
                editingEvent.HasTime = false;
                editingEvent.EndTime = TimeSpan.Zero;
                editingEvent.HasEndTime = false;
            }

            editingEvent.ReminderShown = false; // Reminder zurücksetzen bei Bearbeitung

            await CalendarService.UpdateEventAsync(editingEvent); // In Datenbank speichern
            await LoadEventsAsync(); // Termine neu laden
        }
        CloseEditDialog(); // Dialog schließen
    }

    private async Task DeleteEvent() // Löscht Termin
    {
        if (editingEvent != null) // Check: Event vorhanden?
        {
            await CalendarService.DeleteEventDirectAsync(editingEvent); // Aus Datenbank löschen
            await LoadEventsAsync(); // Termine neu laden
            CloseEditDialog(); // Dialog schließen
        }
    }

    private void CloseDialog() => showAddDialog = false; // Schließt Add-Dialog

    private async Task ConfirmAdd() // Speichert neuen Termin
    {
        await AddEventForDate(dialogDate); // Termin hinzufügen
        showAddDialog = false; // Dialog schließen
    }

    private async Task SaveDayViewEvent() // Speichert Termin direkt aus Tagesansicht
    {
        await AddEventForDate(DisplayDay); // Termin für aktuellen Tag hinzufügen
        // Felder werden bereits in AddEventForDate zurückgesetzt
    }

    private async Task AddEventForDate(DateTime date) // Fügt Termin für Datum hinzu
    {
        if (string.IsNullOrWhiteSpace(newEventText)) return; // Prüfe auf leeren Titel
        var d = date.Date; // Nur Datum ohne Uhrzeit

        TimeSpan time = TimeSpan.Zero; // Standard: keine Startzeit
        bool hasTime = false;
        TimeSpan endTime = TimeSpan.Zero; // Standard: keine Endzeit
        bool hasEndTime = false;

        if (!isAllDay) // Nicht ganztägig?
        {
            TimeSpan parsedTime; // Variable für geparste Startzeit
            bool parseSuccess = TimeSpan.TryParse(selectedTime, out parsedTime); // Parse Startzeit
            if (parseSuccess) // Startzeit gültig?
            {
                time = parsedTime; // Startzeit setzen
                hasTime = true; // Flag setzen
            }

            TimeSpan parsedEnd; // Variable für geparste Endzeit
            bool parseEndSuccess = TimeSpan.TryParse(selectedEndTime, out parsedEnd); // Parse Endzeit
            if (parseEndSuccess && hasTime && parsedEnd > time) // Endzeit gültig und nach Startzeit?
            {
                endTime = parsedEnd; // Endzeit setzen
                hasEndTime = true; // Flag setzen
            }
        }

        var newEvent = new CalendarEvent();
        newEvent.Start = d;
        newEvent.Title = newEventText.Trim();
        newEvent.ColorIndex = selectedColorIndex;
        newEvent.IsAllDay = isAllDay;
        newEvent.Time = time;
        newEvent.HasTime = hasTime;
        newEvent.EndTime = endTime;
        newEvent.HasEndTime = hasEndTime;
        newEvent.ReminderMinutesBefore = newEventReminderMinutes; // Erinnerung hinzufügen

        await CalendarService.AddEventAsync(newEvent); // In Datenbank speichern
        await LoadEventsAsync(); // Termine neu laden

        newEventText = string.Empty; // Eingabefeld leeren
        selectedColorIndex = 0; // Farbe zurücksetzen
        isAllDay = true; // Zurücksetzen
        selectedTime = "09:00"; // Startzeit zurücksetzen
        selectedEndTime = "10:00"; // Endzeit zurücksetzen
        selectedTimeHour = 9;
        selectedTimeMinute = 0;
        selectedEndTimeHour = 10;
        selectedEndTimeMinute = 0;
        newEventReminderMinutes = null; // Erinnerung zurücksetzen
    }

    private List<CalendarEvent> GetEventsForDate(DateTime date) // Liefert alle Termine für ein Datum
    {
        var d = date.Date; // Nur Datum ohne Uhrzeit
        return events.TryGetValue(d, out var list) ? list : new List<CalendarEvent>(); // Liste oder leere Liste zurückgeben
    }

    private string FormatEventTime(CalendarEvent ev) // Hilfsmethode: Formatiert Zeitangabe (Zeitspanne oder nur Startzeit)
    {
        if (ev.HasTime && ev.HasEndTime) // Zeitspanne vorhanden?
        {
            return $"{ev.Time:hh\\:mm}–{ev.EndTime:hh\\:mm}"; // Format: "14:00–16:00"
        }
        return ev.Time.ToString(@"hh\:mm"); // Nur Startzeit: "14:00"
    }

    private string ViewTitle // Titel-Text je nach Ansicht
    {
        get
        {
            if (currentView == "Month") return DisplayMonth.ToString("MMMM yyyy", germanCulture);
            if (currentView == "Week") return $"Woche von {WeekDays.First().ToString("dd.MM.yyyy", germanCulture)}";
            return DisplayDay.ToString("dddd, dd.MM.yyyy", germanCulture);
        }
    }
