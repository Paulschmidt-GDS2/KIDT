@* Daten-Seite: Zeigt Chats und Dokumente in Tabs *@
@page "/daten"
@using KIDT.Models
@using Microsoft.JSInterop
@inject KIDT.Database.ChatDbService ChatDb
@inject KIDT.Database.DocumentDbService DocDb
@inject KIDT.Database.FolderDbService FolderDb
@inject KIDT.Services.ThumbnailGenerator ThumbGen
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IDisposable

<div class="page-container">
    @* Hauptcontainer für gesamte Seite *@
    <div class="tab-navigation">
        @* Tab-Navigation oben *@
        <button class="tab-button @(currentTab == "Chats" ? "active" : "")" @onclick='() => currentTab = "Chats"'>Chats</button>
        <button class="tab-button @(currentTab == "Dokumente" ? "active" : "")" @onclick='() => currentTab = "Dokumente"'>Dokumente</button>
    </div>

    @if (currentTab == "Chats") @* Chats-Tab *@
    {
        <div class="data-container">
            @if (isLoadingChats)
            {
                <div class="loading-container"><p>Chats werden geladen...</p></div>
            }
            else
            {
                <div class="data-grid">
                    @foreach (var chat in Chats)
                    {
                        <div class="chat-card @(removingChatIds.Contains(chat.Id) ? "removing" : "")">
                            <button class="delete-btn" @onclick="@(() => DeleteChat(chat.Id))" @onclick:stopPropagation="true" disabled="@isDeleting" title="Chat löschen" aria-label="Chat löschen">
                                <img src="images/remove.png" alt="Löschen" />
                            </button>
                            <div class="card-content" @onclick="@(() => OpenChat(chat.Id))">
                                <div class="card-title">@chat.Title</div>
                                @if (chat.LinkedDocuments.Count > 0)
                                {
                                    <div class="card-file-preview">
                                        @if (!string.IsNullOrEmpty(chat.LinkedDocuments[0].ThumbnailBase64))
                                        {
                                            <img src="@("data:image/png;base64," + chat.LinkedDocuments[0].ThumbnailBase64)" alt="Vorschau" class="preview-thumbnail" />
                                        }
                                        else
                                        {
                                            <img src="images/file.png" alt="Datei" class="preview-icon-large" />
                                        }
                                    </div>
                                    <div class="card-filename">@chat.LinkedDocuments[0].FileName</div>
                                }
                                <div class="card-date">@GetFormattedDate(chat.CreatedAt)</div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }
    else if (currentTab == "Dokumente") @* Dokumente-Tab *@
    {
        <div class="data-container-documents">
            @if (isLoadingDocuments)
            {
                <div class="loading-container"><p>Dokumente werden geladen...</p></div>
            }
            else
            {
                <div class="documents-explorer">

                    @* === ORDNER-ANSICHT: Breadcrumb-Navigation === *@
                    @if (currentFolderId != null) @* In Ordner: Breadcrumb *@
                    {
                        <div class="folder-nav-bar">
                            <button class="breadcrumb-link" @onclick="NavigateToRoot">Alle Dokumente</button>
                            <span class="breadcrumb-sep">›</span>
                            <span class="breadcrumb-active">@currentFolderName</span>
                        </div>
                    }

                    @* Einfügen-Bar: nur sichtbar wenn Einfügen sinnvoll ist (anderer Standort, kein Namenskonflikt) *@
                    @if (CanPaste)
                    {
                        <div class="paste-bar">
                            <button class="paste-btn" @onclick="PasteDocumentHere">
                                &#128203; "@clipboardDocName" hier einfügen
                            </button>
                        </div>
                    }

                    @* === ROOT-ANSICHT: Ordner-Sektion === *@
                    @if (currentFolderId == null) @* Nur in Root *@
                    {
                        @* Sektion-Header "Ordner" mit "+ Neu"- und Upload-Button *@
                        <div class="explorer-section-header">
                            <span class="section-label">Ordner</span>
                            <div class="section-line"></div>
                            <button class="upload-new-btn" @onclick="OnUploadClick" disabled="@isUploading" title="Datei hochladen">
                                <img src="images/file-upload.png" alt="Datei hochladen" class="upload-img" /> @* Upload-Icon *@
                            </button>
                            <button class="folder-new-btn" @onclick="StartCreateFolder">+ Neu</button>
                        </div>

                        @* Inline-Eingabe: Neuen Ordner erstellen *@
                        @if (isCreatingFolder)
                        {
                            <div class="folder-create-row">
                                <div class="folder-icon-box"></div>
                                <input class="folder-create-input"
                                       value="@newFolderName"
                                       @oninput="OnFolderNameInput"
                                       @onkeydown="OnNewFolderKeyDown"
                                       placeholder="Ordnername eingeben..." />
                                <button class="folder-confirm-btn" @onclick="ConfirmCreateFolder" title="Erstellen">&#10003;</button>
                                <button class="folder-cancel-btn" @onclick="CancelCreateFolder" title="Abbrechen">&#10005;</button>
                            </div>
                            @if (!string.IsNullOrEmpty(folderCreateError)) @* Duplikat-Fehlermeldung unter dem Eingabefeld *@
                            {
                                <div class="inline-error-msg">@folderCreateError</div>
                            }
                        }

                        @* Ordner-Zeilen *@
                        @foreach (var folder in Folders)
                        {
                            <div class="folder-row @(removingFolderIds.Contains(folder.Id) ? "removing" : "")"
                                 @onclick="@(() => OpenFolder(folder.Id, folder.Name))">
                                <div class="folder-icon-box"></div>
                                <div class="document-info">
                                    <div class="document-name">@folder.Name</div>
                                    <div class="document-meta">Ordner &bull; @GetFormattedDate(folder.CreatedAt)</div>
                                </div>
                                <button class="document-delete-btn" @onclick="@(() => DeleteFolder(folder.Id))" @onclick:stopPropagation="true" disabled="@isDeletingFolder" title="Ordner löschen">
                                    <img src="images/remove.png" alt="Löschen" />
                                </button>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(uploadError)) @* Upload-Duplikat-Fehlermeldung *@
                        {
                            <div class="inline-error-msg">@uploadError</div>
                        }

                        @* Sektion-Header "Dokumente" *@
                        @if (Documents.Count > 0 && (Folders.Count > 0 || isCreatingFolder))
                        {
                            <div class="explorer-section-header" style="margin-top: 14px;">
                                <span class="section-label">Dokumente</span>
                                <div class="section-line"></div>
                            </div>
                        }

                        @* Dokument-Zeilen in Root *@
                        @if (Documents.Count == 0 && Folders.Count == 0 && !isCreatingFolder)
                        {
                            <div class="empty-state"><p>Keine Dokumente vorhanden. Datei hochladen um zu beginnen.</p></div>
                        }
                        else
                        {
                            @foreach (var doc in Documents)
                            {
                                <div class="doc-with-dropdown">
                                    <div class="document-row @(removingDocumentIds.Contains(doc.Id) ? "removing" : "") @(selectedDocId == doc.Id ? "selected" : "")"
                                         @onclick="@(() => SelectDocument(doc.Id))"
                                         @ondblclick="@(() => OpenDocument(doc.Id))"
                                         @onclick:stopPropagation="true">
                                        <div class="document-thumbnail">
                                            @if (!string.IsNullOrEmpty(doc.ThumbnailBase64))
                                            {
                                                <img src="@("data:image/png;base64," + doc.ThumbnailBase64)" alt="Vorschau" class="doc-thumb-img" />
                                            }
                                            else
                                            {
                                                <img src="images/file.png" alt="@doc.FileType" class="doc-icon-img" />
                                            }
                                        </div>
                                        <div class="document-info">
                                            <div class="document-name">@doc.FileName</div>
                                            <div class="document-meta">@doc.FileType.ToUpper() &bull; @GetFormattedDate(doc.UploadedAt)</div>
                                        </div>
                                        @if (Folders.Count > 0) @* Kopieren + Verschieben nur wenn Ordner existieren *@
                                        {
                                            <button class="copy-btn" @onclick="@(() => CopyToClipboard(doc.Id, doc.FileName))" @onclick:stopPropagation="true" title="Kopieren (Strg+C)">
                                                <svg class="copy-svg" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                    <rect x="5" y="1" width="11" height="13" rx="1.5" stroke="currentColor" stroke-width="1.6"/>
                                                    <rect x="2" y="4" width="11" height="13" rx="1.5" stroke="currentColor" stroke-width="1.6" fill="var(--clr-surface, #fff)"/>
                                                </svg>
                                            </button>
                                            <button class="move-btn" @onclick="@(() => ToggleMoveDropdown(doc.Id))" @onclick:stopPropagation="true" title="In Ordner verschieben">
                                                <svg class="move-svg" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                    <rect x="2" y="11" width="14" height="5" rx="1" stroke="currentColor" stroke-width="1.5"/>
                                                    <path d="M9 2v9M9 11l-3-3M9 11l3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                                </svg>
                                            </button>
                                        }
                                        <button class="document-delete-btn" @onclick="@(() => DeleteDocument(doc.Id))" @onclick:stopPropagation="true" disabled="@isDeletingDocument" title="Dokument löschen">
                                            <svg class="delete-svg" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                <path d="M4.5 4.5l9 9M13.5 4.5l-9 9" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
                                            </svg>
                                        </button>
                                    </div>
                                    @if (moveDropdownDocId == doc.Id)
                                    {
                                        <div class="move-dropdown">
                                            @foreach (var folder in Folders)
                                            {
                                                <div class="move-option" @onclick="@(() => MoveDocumentTo(doc.Id, folder.Id))">
                                                    <div class="move-option-folder-icon"></div>
                                                    @folder.Name
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        }
                    }

                    @* === IN ORDNER: Dokument-Liste === *@
                    @if (currentFolderId != null)
                    {
                        @* Upload-Button auch im Ordner *@
                        <div class="explorer-section-header" style="margin-bottom: 12px;">
                            <span class="section-label">Dokumente</span>
                            <div class="section-line"></div>
                            <button class="upload-new-btn" @onclick="OnUploadClick" disabled="@isUploading" title="Datei hochladen">
                                <img src="images/file-upload.png" alt="Datei hochladen" class="upload-img" /> @* Upload-Icon *@
                            </button>
                        </div>

                        @if (!string.IsNullOrEmpty(uploadError)) @* Upload-Duplikat-Fehlermeldung im Ordner *@
                        {
                            <div class="inline-error-msg">@uploadError</div>
                        }

                        @if (Documents.Count == 0)
                        {
                            <div class="empty-state"><p>Keine Dokumente in diesem Ordner</p></div>
                        }
                        else
                        {
                            @foreach (var doc in Documents)
                            {
                                <div class="doc-with-dropdown">
                                    <div class="document-row @(removingDocumentIds.Contains(doc.Id) ? "removing" : "") @(selectedDocId == doc.Id ? "selected" : "")"
                                         @onclick="@(() => SelectDocument(doc.Id))"
                                         @ondblclick="@(() => OpenDocument(doc.Id))"
                                         @onclick:stopPropagation="true">
                                        <div class="document-thumbnail">
                                            @if (!string.IsNullOrEmpty(doc.ThumbnailBase64))
                                            {
                                                <img src="@("data:image/png;base64," + doc.ThumbnailBase64)" alt="Vorschau" class="doc-thumb-img" />
                                            }
                                            else
                                            {
                                                <img src="images/file.png" alt="@doc.FileType" class="doc-icon-img" />
                                            }
                                        </div>
                                        <div class="document-info">
                                            <div class="document-name">@doc.FileName</div>
                                            <div class="document-meta">@doc.FileType.ToUpper() &bull; @GetFormattedDate(doc.UploadedAt)</div>
                                        </div>
                                        <button class="copy-btn" @onclick="@(() => CopyToClipboard(doc.Id, doc.FileName))" @onclick:stopPropagation="true" title="Kopieren (Strg+C)">
                                            <svg class="copy-svg" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                <rect x="5" y="1" width="11" height="13" rx="1.5" stroke="currentColor" stroke-width="1.6"/>
                                                <rect x="2" y="4" width="11" height="13" rx="1.5" stroke="currentColor" stroke-width="1.6" fill="var(--clr-surface, #fff)"/>
                                            </svg>
                                        </button>
                                        <button class="move-btn" @onclick="@(() => ToggleMoveDropdown(doc.Id))" @onclick:stopPropagation="true" title="Verschieben">
                                            <svg class="move-svg" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                <rect x="2" y="11" width="14" height="5" rx="1" stroke="currentColor" stroke-width="1.5"/>
                                                <path d="M9 2v9M9 11l-3-3M9 11l3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                            </svg>
                                        </button>
                                        <button class="document-delete-btn" @onclick="@(() => DeleteDocument(doc.Id))" @onclick:stopPropagation="true" disabled="@isDeletingDocument" title="Dokument löschen">
                                            <svg class="delete-svg" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                <path d="M4.5 4.5l9 9M13.5 4.5l-9 9" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
                                            </svg>
                                        </button>
                                    </div>
                                    @if (moveDropdownDocId == doc.Id)
                                    {
                                        <div class="move-dropdown">
                                            <div class="move-option" @onclick="@(() => MoveDocumentTo(doc.Id, null))">
                                                <div class="move-option-root-icon"></div>
                                                Nur im Hauptbereich
                                            </div>
                                            @foreach (var folder in Folders)
                                            {
                                                @if (folder.Id != currentFolderId)
                                                {
                                                    <div class="move-option" @onclick="@(() => MoveDocumentTo(doc.Id, folder.Id))">
                                                        <div class="move-option-folder-icon"></div>
                                                        @folder.Name
                                                    </div>
                                                }
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        }
                    }

                </div>
            }
        </div>
    }
</div>
