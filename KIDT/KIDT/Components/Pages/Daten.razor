@* Daten-Seite: Zeigt Chats und Dokumente in Tabs *@
@page "/daten"
@using KIDT.Models
@inject KIDT.Database.ChatDbService ChatDb
@inject KIDT.Database.DocumentDbService DocDb
@inject NavigationManager Navigation

<div class="page-container">
    @* Hauptcontainer für gesamte Seite *@
    <div class="tab-navigation">
        @* Tab-Navigation oben *@
        <button class="tab-button @(currentTab == "Chats" ? "active" : "")" @onclick='() => currentTab = "Chats"'>Chats</button>
        <button class="tab-button @(currentTab == "Dokumente" ? "active" : "")" @onclick='() => currentTab = "Dokumente"'>Dokumente</button>
    </div>

    @if (currentTab == "Chats") @* Chats-Tab *@
    {
        <div class="data-container">
            @* Hauptcontainer *@
            @if (isLoadingChats) @* Zeige Loading-Indikator *@
            {
                <div class="loading-container">
                    <p>Chats werden geladen...</p>
                </div>
            }
            else
            {
                <div class="data-grid">
                    @* Grid-Container für Chat-Cards *@
                    @foreach (var chat in Chats) @* Durchlaufe alle Chats *@
                    {
                        <div class="chat-card @(removingChatIds.Contains(chat.Id) ? "removing" : "")">
                            @* Chat-Card *@
                            <button class="delete-btn" @onclick="@(() => DeleteChat(chat.Id))" @onclick:stopPropagation="true" disabled="@isDeleting" title="Chat löschen" aria-label="Chat löschen">
                                @* Lösch-Button (disabled während Löschvorgang) *@
                                <img src="images/remove.png" alt="Löschen" />
                            </button>
                            <div class="card-content" @onclick="@(() => OpenChat(chat.Id))">
                                @* Klickbarer Bereich für OpenChat *@
                                <div class="card-title">@chat.Title</div> @* Chat-Titel oben *@
                            
                                @if (chat.LinkedDocuments.Count > 0) @* Check: Hat dieser Chat verknüpfte Dokumente? *@
                                {
                                    <div class="card-file-preview">
                                        @* File-Vorschau mit Thumbnail *@
                                        @if (!string.IsNullOrEmpty(chat.LinkedDocuments[0].ThumbnailBase64)) @* Check: Hat Dokument ein Thumbnail? *@
                                        {
                                            <img src="@("data:image/png;base64," + chat.LinkedDocuments[0].ThumbnailBase64)" alt="Vorschau" class="preview-thumbnail" />
                                        }
                                        else
                                        @* Kein Thumbnail -> Zeige Icon *@
                                        {
                                            @if (chat.LinkedDocuments[0].FileName.EndsWith(".pdf")) @* PDF-Icon *@
                                            {
                                                <img src="images/file.png" alt="PDF" class="preview-icon-large" />
                                            }
                                            else if (chat.LinkedDocuments[0].FileName.EndsWith(".txt"))
                                            @* TXT-Icon *@
                                            {
                                                <img src="images/file.png" alt="Text" class="preview-icon-large" />
                                            }
                                            else
                                            @* Sonstiges *@
                                            {
                                                <img src="images/file.png" alt="Datei" class="preview-icon-large" />
                                            }
                                        }
                                    </div>
                                
                                    <div class="card-filename">@chat.LinkedDocuments[0].FileName</div> @* Dateiname darunter *@
                                }
                            
                                <div class="card-date">@GetFormattedDate(chat.CreatedAt)</div> @* Datum ganz unten (konvertiert zu Lokalzeit) *@
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }
    else if (currentTab == "Dokumente")
    @* Dokumente-Tab *@
    {
        <div class="data-container-documents">
            @* Hauptcontainer für Explorer-Ansicht *@
            @if (isLoadingDocuments) @* Zeige Loading-Indikator *@
            {
                <div class="loading-container">
                    <p>Dokumente werden geladen...</p>
                </div>
            }
            else
            {
                <div class="documents-explorer">
                    @* Explorer-Container *@
                    @if (Documents.Count == 0) @* Keine Dokumente vorhanden *@
                    {
                        <div class="empty-state">
                            <p>Keine Dokumente vorhanden</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var doc in Documents) @* Durchlaufe alle Dokumente *@
                        {
                            <div class="document-row @(removingDocumentIds.Contains(doc.Id) ? "removing" : "")" @onclick="@(() => OpenDocument(doc.Id))" @onclick:stopPropagation="true">
                                @* Klick öffnet Dokument *@
                                <div class="document-thumbnail">
                                    @* Thumbnail/Icon Bereich *@
                                    @if (!string.IsNullOrEmpty(doc.ThumbnailBase64)) @* Check: Hat Dokument ein Thumbnail? *@
                                    {
                                        <img src="@("data:image/png;base64," + doc.ThumbnailBase64)" alt="Vorschau" class="doc-thumb-img" />
                                    }
                                    else
                                    @* Kein Thumbnail -> Zeige Icon *@
                                    {
                                        <img src="images/file.png" alt="@doc.FileType" class="doc-icon-img" />
                                    }
                                </div>
                                <div class="document-info">
                                    @* Info-Bereich *@
                                    <div class="document-name">@doc.FileName</div> @* Dateiname *@
                                    <div class="document-meta">@doc.FileType.ToUpper() • @GetFormattedDate(doc.UploadedAt)</div> @* Typ und Datum *@
                                </div>
                                <button class="document-delete-btn" @onclick="@(() => DeleteDocument(doc.Id))" @onclick:stopPropagation="true" disabled="@isDeletingDocument" title="Dokument löschen" aria-label="Dokument löschen">
                                    @* Lösch-Button (stopPropagation verhindert doppeltes Event) *@
                                    <img src="images/remove.png" alt="Löschen" />
                                </button>
                            </div>
                        }
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    private string currentTab = "Chats";
    private List<Conversation> Chats = new List<Conversation>();
    private List<Document> Documents = new List<Document>();
    private bool isDeleting = false;
    private bool isDeletingDocument = false;
    private bool isLoadingChats = true;
    private bool isLoadingDocuments = true;
    private List<int> removingChatIds = new List<int>(); // IDs die gerade animiert entfernt werden
    private List<int> removingDocumentIds = new List<int>(); // IDs die gerade animiert entfernt werden

    protected override async Task OnInitializedAsync() // Wird beim Laden der Seite aufgerufen
    {
        await Task.Yield(); // Gibt UI-Thread frei
    
        Chats = await ChatDb.LoadAllConversationsAsync(); // Lade Conversations für Listen-Anzeige
        isLoadingChats = false; // Loading für Chats beendet
        StateHasChanged(); // UI aktualisieren

        Documents = await DocDb.GetAllDocumentsAsync(); // Lade Dokumente für Listen-Anzeige
        isLoadingDocuments = false; // Loading für Dokumente beendet
        StateHasChanged(); // UI aktualisieren
    }

    private void OpenChat(int chatId) // Öffnet einen Chat
    {
        Navigation.NavigateTo("/chat/" + chatId); // Navigiere zu Chat mit ID
    }

    private async Task DeleteChat(int chatId) // Löscht einen Chat
    {
        if (isDeleting) return; // Verhindert mehrfache gleichzeitige Lösch-Operationen

        isDeleting = true; // Setze Flag

        // 1. EXIT-ANIMATION: Füge ID zur Removing-Liste hinzu → CSS-Klasse wird gesetzt
        removingChatIds.Add(chatId);
        StateHasChanged();
        await Task.Delay(340); // Warte bis Card-Animation fertig ist (0.32s + kleiner Puffer)

        // 2. Entferne aus UI nach Animation
        Chats = Chats.Where(c => c.Id != chatId).ToList();
        removingChatIds.Remove(chatId);
        StateHasChanged();
    
        // 2. DANN: Lösche aus DB im Hintergrund
        try
        {
            await Task.Run(async () =>
            {
                await ChatDb.DeleteConversationAsync(chatId); // DB-Löschung im Hintergrund
            });
        }
        catch (Exception ex)
        {
            // Bei Fehler: Chat wieder hinzufügen (Rollback)
            System.Diagnostics.Debug.WriteLine($"Fehler beim Löschen: {ex.Message}");
            // Chat ist schon aus UI entfernt, aber nicht aus DB - beim nächsten Laden erscheint er wieder
        }
        finally
        {
            isDeleting = false; // Flag zurücksetzen
        }
    }

    private async Task DeleteDocument(int documentId) // Löscht ein Dokument
    {
        if (isDeletingDocument) return; // Verhindert mehrfache gleichzeitige Lösch-Operationen

        isDeletingDocument = true; // Setze Flag

        // 1. EXIT-ANIMATION: Row nach rechts rausschieben
        removingDocumentIds.Add(documentId);
        StateHasChanged();
        await Task.Delay(300); // Warte bis Row-Animation fertig ist (0.28s + kleiner Puffer)

        // 2. Entferne aus UI nach Animation
        Documents = Documents.Where(d => d.Id != documentId).ToList();
        removingDocumentIds.Remove(documentId);
        StateHasChanged();
    
        // 2. DANN: Lösche aus DB im Hintergrund
        try
        {
            await Task.Run(async () =>
            {
                await DocDb.DeleteDocumentAsync(documentId); // DB-Löschung im Hintergrund
            });
        }
        catch (Exception ex)
        {
            // Bei Fehler: Dokument wieder hinzufügen (Rollback)
            System.Diagnostics.Debug.WriteLine($"Fehler beim Löschen des Dokuments: {ex.Message}");
            // Dokument ist schon aus UI entfernt, aber nicht aus DB - beim nächsten Laden erscheint es wieder
        }
        finally
        {
            isDeletingDocument = false; // Flag zurücksetzen
        }
    }

    private string GetFormattedDate(DateTime createdAt) // Formatiert Datum korrekt
    {
        if (createdAt.Year < 2000) // Check: Ist Datum ungültig (0001 oder ähnlich)?
        {
            return "Unbekanntes Datum"; // Zeige Fallback
        }
    
        // Behandle als UTC und konvertiere zu Lokalzeit
        DateTime localTime = createdAt.Kind == DateTimeKind.Unspecified
            ? DateTime.SpecifyKind(createdAt, DateTimeKind.Utc).ToLocalTime()
            : createdAt.ToLocalTime();
    
        return localTime.ToString("dd.MM.yyyy HH:mm"); // Formatiere lokal
    }

    private async Task OpenDocument(int documentId) // Öffne Dokument in Standard-Anwendung
    {
        try
        {
            var doc = await DocDb.GetDocumentByIdAsync(documentId); // Lade Dokument aus DB
            if (doc == null) // Dokument nicht gefunden
            {
                return;
            }
        
            string tempPath = Path.Combine(Path.GetTempPath(), doc.FileName); // Erstelle Pfad in Temp-Ordner
        
            if (doc.FileType == "pdf") // PDF muss von Base64 konvertiert werden
            {
                try
                {
                    await File.WriteAllBytesAsync(tempPath, Convert.FromBase64String(doc.FileContent)); // Konvertiere Base64 zu Bytes und schreibe
                }
                catch (FormatException) // Fallback falls nicht Base64
                {
                    await File.WriteAllTextAsync(tempPath, doc.FileContent); // Schreibe als Text
                }
            }
            else // Text-Dateien direkt schreiben
            {
                await File.WriteAllTextAsync(tempPath, doc.FileContent); // Schreibe als Text
            }
        
            System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo(tempPath) { UseShellExecute = true }); // Öffne Datei in Standard-App
        }
        catch { } // Fehler ignorieren (silent fail)
    }
}