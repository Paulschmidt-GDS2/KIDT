@* Chat-Hauptseite in Main mit Chat-History und Inputbox *@
@page "/"
@page "/chat/{ChatId:int}"
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using Microsoft.Extensions.DependencyInjection
@using KIDT.Models
@inject KIDT.Services.ChatCoordinator Chat
@inject KIDT.Database.ChatDbService Db
@inject KIDT.Services.ThumbnailGenerator ThumbGen
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject IServiceProvider ServiceProvider
@implements IDisposable

<div class="chat-container">
    @* Hauptcontainer *@
    <div class="messages" @ref="messagesRef">
        @* Bereich mit Nachrichten und Scroll *@
        <div class="messages-inner">
            @* Innenbereich, Nachrichtenliste *@
            @foreach (var msg in Messages)
            {
                string bubbleClass; // Variable für CSS-Klasse der Bubble
                if (msg.IsUser) // Check: Ist es User-Nachricht?
                {
                    bubbleClass = "message-bubble user";
                }
                else // Nein, Assistent-Nachricht
                {
                    bubbleClass = "message-bubble assistant";
                }

                <div class="@bubbleClass">
                    @if (msg.IsLoading) @* Check: Ist dies eine Loading-Nachricht? *@
                    {
                        @if (!string.IsNullOrEmpty(msg.LoadingText)) @* Shimmer-Text erscheint nach 2.5s *@
                        {
                            <span class="loading-shimmer-text">@msg.LoadingText</span>
                        }
                        <span class="blinking-cursor">_</span> @* Cursor blinkt immer weiter *@
                    }
                    else if (msg.IsUser)
                    @* Wenn User-Nachricht *@
                    {
                        @msg.Text @* Nur Text, keine Cards *@
                    }
                    else
                    @* Wenn Assistent-Nachricht *@
                    {
                        @if (!string.IsNullOrEmpty(msg.ModelLabel)) @* Debug-Label: nur wenn Modell bekannt *@
                        {
                            <span class="model-debug-label">[@msg.ModelLabel]</span> @* Modell-Label über der Antwort *@
                        }
                        <span class="typewriter">@msg.DisplayText</span> @* Typewriter-Text *@

                        @* Zeige gefundene Dokumente als Cards (nur bei Assistent-Nachrichten) *@
                        @if (msg.FoundDocuments.Count > 0)
                        {
                            <div class="found-documents-grid"> @* Grid-Container für Dokument-Cards *@
                                @foreach (var doc in msg.FoundDocuments) @* Durchlaufe alle gefundenen Dokumente *@
                                {
                                    <div class="document-card-chat"> @* Einzelne Dokument-Card *@
                                        <div class="doc-card-content" @onclick="@(() => OpenDocument(doc.Id))"> @* Klick öffnet Dokument in Standard-App *@
                                            @if (!string.IsNullOrEmpty(doc.ThumbnailBase64)) @* Thumbnail vorhanden? *@
                                            {
                                                <img src="@($"data:image/png;base64,{doc.ThumbnailBase64}")" class="doc-thumbnail-chat" alt="@doc.FileName" /> @* Base64-Thumbnail als Inline-Bild *@
                                            }
                                            else @* Kein Thumbnail: Fallback-Icon *@
                                            {
                                                <div class="doc-icon-placeholder">
                                                    <img src="images/file.png" alt="@doc.FileType" class="doc-icon-chat" />
                                                </div>
                                            }
                                            <div class="doc-details-chat"> @* Datei-Details unter dem Bild *@
                                                <span class="doc-name-chat">@doc.FileName</span>
                                                <span class="doc-type-chat">@doc.FileType.ToUpper()</span>
                                            </div>
                                        </div>
                                        <button class="add-doc-btn" @onclick="@(() => AddDocumentToChat(doc.Id))" @onclick:stopPropagation="true"> @* stopPropagation: verhindert OpenDocument-Trigger *@
                                            Zum Chat hinzufügen
                                        </button>
                                    </div>
                                }
                            </div>
                        }

                        @* Zeige gefundene Termine als Cards (nur bei Assistent-Nachrichten) *@
                        @if (msg.FoundEvents.Count > 0)
                        {
                            <div class="found-events-grid"> @* Grid-Container für Termin-Cards *@
                                @foreach (var evt in msg.FoundEvents) @* Durchlaufe alle gefundenen Termine *@
                                {
                                    string eventTimeString;
                                    if (evt.IsAllDay) // Ganztägig?
                                    {
                                        eventTimeString = "Ganztägig";
                                    }
                                    else if (evt.HasTime && evt.HasEndTime) // Zeitspanne?
                                    {
                                        eventTimeString = $"{evt.Time:hh\\:mm} – {evt.EndTime:hh\\:mm}";
                                    }
                                    else if (evt.HasTime) // Nur Startzeit?
                                    {
                                        eventTimeString = evt.Time.ToString(@"hh\:mm");
                                    }
                                    else
                                    {
                                        eventTimeString = "Keine Zeit";
                                    }
                                    string[] eventColorClasses = new[] { "event-color-0", "event-color-1", "event-color-2", "event-color-3", "event-color-4", "event-color-5", "event-color-6", "event-color-7" };
                                    string eventColorClass = eventColorClasses[evt.ColorIndex]; // CSS-Klasse für Termin-Farbe anhand Index

                                    <div class="event-card-chat @eventColorClass" @onclick="@(() => OpenEventEditDialog(evt.Id))"> @* Klick öffnet Edit-Dialog *@
                                        <div class="event-card-top"> @* Obere Zeile: Datum, Zeit, Löschen-Button *@
                                            <div class="event-card-header">
                                                <span class="event-date-chat">@evt.Start.ToString("dd.MM.yyyy")</span> @* Datum formatiert *@
                                                <span class="event-time-chat">@eventTimeString</span> @* Zeitanzeige (Ganztägig / Uhrzeit / Spanne) *@
                                            </div>
                                            <button class="delete-event-btn-small" @onclick="@(() => DeleteEventFromChat(evt.Id))" @onclick:stopPropagation="true" title="Termin löschen">Löschen</button> @* stopPropagation: verhindert Edit-Dialog-Öffnung *@
                                        </div>
                                        <div class="event-title-chat">@evt.Title</div>
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
            }
        </div>
    </div>

    <div class="chat-input-container"> @* Unterer Bereich: Datei-Badge + Eingabefeld *@

        @if (!string.IsNullOrEmpty(UploadedFileName)) @* Check: Ist Datei angehängt? *@
        {
            <div class="file-badge"> @* Badge über dem Eingabefeld *@
                <img src="images/file.png" alt="Datei" class="file-icon" />
                <span class="file-name">@UploadedFileName</span>
                <button class="file-remove" @onclick="RemoveFile" title="Datei entfernen" aria-label="Datei entfernen">
                    <svg class="btn-icon" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M4.5 4.5l9 9M13.5 4.5l-9 9" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
                    </svg>
                </button>
            </div>
        }

        <div class="chat-input" role="search" aria-label="Chat Eingabe"> @* Eingabefeld-Wrapper *@
            <textarea @ref="textareaRef" id="chatTextarea" class="chat-textbox" placeholder="Nachricht eingeben..." aria-label="Chat Nachricht" @bind="InputText" @bind:event="oninput" rows="@rows" cols="@Cols" spellcheck="false"></textarea> @* oninput: live binding (nicht bei blur) *@
            <div class="chat-actions @GetActionsClass()"> @* GetActionsClass: active/no-abort je nach Zustand *@
                <button class="chat-upload" title="Datei hochladen" aria-label="Datei hochladen" @onclick="OnUploadClick"> @* Upload-Button: öffnet Datei-Dialog *@
                    <img src="images/file-upload.png" alt="Datei hochladen" class="btn-icon" /> @* Upload-Icon *@
                </button>
                <button class="@GetSendClass()" @onclick="OnSendOrAbort" title="@GetSendTitle()"> @* GetSendClass/Title: wechselt zwischen Senden und Abbrechen *@
                    @if (isSaving) @* Sendet gerade: Abbruch-Icon *@
                    {
                        <img src="images/cancel.png" alt="Abbrechen" class="btn-icon" />
                    }
                    else @* Bereit zum Senden: Send-Icon *@
                    {
                        <img src="images/send.png" alt="Senden" class="btn-icon" />
                    }
                </button>
            </div>
        </div>
    </div>
</div>

@* Edit-Dialog für Termin-Bearbeitung (nur sichtbar wenn showEventEditDialog = true) *@
@if (showEventEditDialog && editingEvent != null)
{
    <div class="dialog-backdrop" @onclick="CloseEventEditDialog"> @* Klick auf Hintergrund schließt Dialog *@
        <div class="dialog edit-dialog" @onclick:stopPropagation="true"> @* stopPropagation: verhindert Schließen bei Klick ins Dialog-Innere *@
            <h4 class="dialog-title">Termin bearbeiten</h4>
            <div class="dialog-date"> @* Datum wird nur angezeigt, nicht editierbar *@
                <label>Datum: </label>@editingEvent.Start.ToString("dd.MM.yyyy")
            </div>

            <div class="dialog-input-group"> @* Titel-Eingabe *@
                <label class="input-label">Titel:</label>
                <input class="dialog-input" @bind="editEventTitle" /> @* Zwei-Wege-Binding auf editEventTitle *@
            </div>

            <div class="dialog-time-group"> @* Uhrzeit-Bereich: Checkbox + optionale Zeitspanne *@
                <div class="checkbox-wrapper">
                    <input type="checkbox" id="editAllDay" class="time-checkbox" @bind="editIsAllDay" />
                    <label for="editAllDay" class="checkbox-label">Ganztägig</label>
                </div>
                @if (!editIsAllDay) @* Zeitspanne nur einblenden wenn nicht ganztägig *@
                {
                    <div class="time-span-row"> @* Von/Bis-Zeile nebeneinander *@
                        <div class="time-input-wrapper"> @* Startzeit-Gruppe *@
                            <label class="input-label">Von:</label>
                            <div class="time-custom-group"> @* Stunden + Minuten getrennt *@
                                <input type="text" class="time-num-input" value="@(editTimeHour.ToString("D2"))" @onchange="OnEditStartHourChanged" placeholder="HH" /> @* D2: zweistellig (z.B. "09") *@
                                <span class="time-colon">:</span>
                                <input type="text" class="time-num-input" value="@(editTimeMinute.ToString("D2"))" @onchange="OnEditStartMinuteChanged" placeholder="MM" />
                            </div>
                        </div>
                        <span class="time-span-separator">–</span> @* Trennzeichen zwischen Von und Bis *@
                        <div class="time-input-wrapper"> @* Endzeit-Gruppe *@
                            <label class="input-label">Bis:</label>
                            <div class="time-custom-group">
                                <input type="text" class="time-num-input" value="@(editEndTimeHour.ToString("D2"))" @onchange="OnEditEndHourChanged" placeholder="HH" />
                                <span class="time-colon">:</span>
                                <input type="text" class="time-num-input" value="@(editEndTimeMinute.ToString("D2"))" @onchange="OnEditEndMinuteChanged" placeholder="MM" />
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="dialog-color-section"> @* Farb-Auswahl für Termin *@
                <div class="color-picker-label">Farbe wählen:</div>
                <div class="dialog-color-picker">
                    @for (int i = 0; i < editAvailableColors.Length; i++) @* Durchlaufe alle 8 Farben *@
                    {
                        var colorIndex = i;
                        <div class="color-option @(editColorIndex == colorIndex ? "selected" : "")"
                             style="background: @editAvailableColors[colorIndex];"
                             @onclick="() => editColorIndex = colorIndex"> @* Klick setzt aktiven Index *@
                        </div>
                    }
                </div>
            </div>

            <div class="dialog-reminder-section"> @* Erinnerungs-Auswahl *@
                <div class="reminder-label-header">Erinnerung</div>
                <div class="reminder-buttons"> @* Auswahl-Buttons: "active"-Klasse zeigt aktive Auswahl *@
                    <button type="button" class="reminder-btn @(editReminderMinutes == null ? "active" : "")"
                            @onclick="() => editReminderMinutes = null"> @* null = keine Erinnerung *@
                        Keine
                    </button>
                    <button type="button" class="reminder-btn @(editReminderMinutes == 5 ? "active" : "")"
                            @onclick="() => editReminderMinutes = 5">
                        5 Min
                    </button>
                    <button type="button" class="reminder-btn @(editReminderMinutes == 15 ? "active" : "")"
                            @onclick="() => editReminderMinutes = 15">
                        15 Min
                    </button>
                    <button type="button" class="reminder-btn @(editReminderMinutes == 30 ? "active" : "")"
                            @onclick="() => editReminderMinutes = 30">
                        30 Min
                    </button>
                    <button type="button" class="reminder-btn @(editReminderMinutes == 60 ? "active" : "")"
                            @onclick="() => editReminderMinutes = 60">
                        1 Stunde
                    </button>
                    <button type="button" class="reminder-btn @(editReminderMinutes == 120 ? "active" : "")"
                            @onclick="() => editReminderMinutes = 120">
                        2 Stunden
                    </button>
                    <button type="button" class="reminder-btn @(editReminderMinutes == 1440 ? "active" : "")"
                            @onclick="() => editReminderMinutes = 1440">
                        1 Tag
                    </button>
                    <button type="button" class="reminder-btn @(editReminderMinutes == 10080 ? "active" : "")"
                            @onclick="() => editReminderMinutes = 10080">
                        1 Woche
                    </button>
                </div>
                @if (editReminderMinutes != null && editingEvent != null && editingEvent.ReminderShown) @* Hinweis: Erinnerung bereits ausgelöst *@
                {
                    <div class="reminder-status-shown">Erinnerung wurde bereits angezeigt</div>
                }
            </div>

            <div class="dialog-actions"> @* Aktions-Buttons: Speichern / Löschen / Abbrechen *@
                <button class="dialog-button save-button" @onclick="SaveEventEdit">Speichern</button> @* Speichert Änderungen in DB *@
                <button class="dialog-button delete-button" @onclick="DeleteEventFromDialog">Löschen</button> @* Löscht Termin aus DB *@
                <button class="dialog-button cancel-button" @onclick="CloseEventEditDialog">Abbrechen</button> @* Schließt Dialog ohne Speichern *@
            </div>
        </div>
    </div>
}