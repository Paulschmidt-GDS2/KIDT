<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <RootNamespace>KIDT.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Reine Logik-Klassen der App per Link einkompilieren (keine MAUI-/DB-Abhängigkeit) -->
  <ItemGroup>
    <Compile Include="..\KIDT\Services\Logic\CalendarLogic.cs" Link="Logic\CalendarLogic.cs" />
    <Compile Include="..\KIDT\Services\Logic\ToolNameConverter.cs" Link="Logic\ToolNameConverter.cs" />
    <Compile Include="..\KIDT\Services\Logic\RouterFunctionName.cs" Link="Logic\RouterFunctionName.cs" />
    <Compile Include="..\KIDT\Services\Logic\UserInputValidator.cs" Link="Logic\UserInputValidator.cs" />
    <Compile Include="..\KIDT\Services\Logic\LlmResponseCleaner.cs" Link="Logic\LlmResponseCleaner.cs" />
  </ItemGroup>

</Project>
